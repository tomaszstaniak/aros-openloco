+
+def _sha256(path):
+    import hashlib
+    h=hashlib.sha256()
+    with open(path,'rb') as f:
+        for block in iter(lambda:f.read(1<<20),b''): h.update(block)
+    return h.hexdigest()
+
+
+def copy_results(source, destination):
+    """Copy a mounted results volume and verify every file.
+
+    Contents, permission bits and times are copied; file flags are not. AROS
+    sets FAT's archive attribute on files it writes, which macOS reports as
+    SF_ARCHIVED - a super-user flag, so copystat()'s chflags() fails with EPERM
+    after the contents are already in place. shutil.copytree() collected those
+    and made collect exit 1 while every file had arrived intact.
+
+    Each copy is hashed against its source on the read-only mount, and the
+    hashes are written to COLLECT-MANIFEST.sha256 in the destination, so a
+    later reader can check what arrived without the machine. Returns a list of
+    (path, problem); empty means everything copied and matched."""
+    source=Path(source);destination=Path(destination)
+    problems=[];manifest=[]
+    destination.mkdir(parents=True)
+    for root,dirs,files in os.walk(source):
+        dirs.sort();rel=Path(root).relative_to(source)
+        for name in dirs:
+            if (Path(root)/name).is_symlink(): problems.append((str(rel/name),'symlink not copied'));continue
+            (destination/rel/name).mkdir()
+        for name in sorted(files):
+            src=Path(root)/name;dst=destination/rel/name
+            if rel==Path('.') and name==MANIFEST:
+                problems.append((name,'the results volume holds a file with the manifest name; not copied'));continue
+            if not stat.S_ISREG(src.lstat().st_mode):
+                problems.append((str(rel/name),'not a regular file; not copied'));continue
+            shutil.copyfile(src,dst)
+            st=src.stat()
+            os.chmod(dst,stat.S_IMODE(st.st_mode))
+            os.utime(dst,ns=(st.st_atime_ns,st.st_mtime_ns))
+            digest=_sha256(dst)
+            if digest!=_sha256(src): problems.append((str(rel/name),'checksum differs from the source after copy'))
+            manifest.append(digest+'  '+str(rel/name))
+    # Directory times last: writing into a directory changes its mtime.
+    for root,dirs,files in os.walk(source,topdown=False):
+        rel=Path(root).relative_to(source)
+        if (destination/rel).is_dir():
+            st=Path(root).stat();os.utime(destination/rel,ns=(st.st_atime_ns,st.st_mtime_ns))
+    (destination/MANIFEST).write_text(''.join(line+'\n' for line in manifest))
+    return problems
 
 
