index 0000000..69aa8e4
--- /dev/null
+++ b/src/Core/include/OpenLoco/Core/StartupMarker.hpp
@@ -0,0 +1,46 @@
+/// @file
+/// Numbered progress markers for locating a call that never returns.
+///
+/// Why this is not Logging: the logging path buffers, and a call that hangs
+/// takes whatever is still in the buffer with it. These print straight to
+/// stdout and flush immediately, so the last line on screen is the last thing
+/// that actually happened.
+///
+/// Why stdout and not a file: on AROS a file on the volume is never flushed
+/// when the process is stuck, RAM: cannot be read once the GUI is wedged, and
+/// the serial log is empty on AROS One. The console is the only channel that
+/// survives, which is what this exists for - see backlog item 21.
+///
+/// The numbering is deliberately sparse so that markers can be inserted later
+/// without renumbering the ones around them.
+
+/// The console alone was not enough: an AROS Shell window can be taller than
+/// the screen, its newest line is drawn at the very bottom edge, and a wedged
+/// GUI cannot be scrolled - so "the last line I can see" was never provably
+/// the last line written. Each marker is therefore also appended to a file
+/// that is **closed immediately**, which commits it: a file left open by a
+/// process that then hangs is never flushed, but one closed after every write
+/// is already on disk and can be read from the host once QEMU is stopped.
+///
+/// The path is fixed rather than configurable through the environment: on AROS
+/// the Shell's `setenv` does not reach posixc's getenv(), so such a knob would
+/// look adjustable and silently never fire.
+
+#pragma once
+
+#include <cstdio>
+
+namespace OpenLoco
+{
+    inline void mark(int n, const char* what)
+    {
+        std::printf("[MARK %02d] %s\n", n, what);
+        std::fflush(stdout);
+
+        if (FILE* f = std::fopen("Locohome:loco/markers.txt", "a"))
+        {
+            std::fprintf(f, "[MARK %02d] %s\n", n, what);
+            std::fclose(f);
+        }
+    }
+}
