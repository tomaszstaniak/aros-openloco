@@ -75,7 +77,17 @@ namespace OpenLoco::Gfx
 
     void SoftwareDrawingEngine::initialize(SDL_Window* window)
     {
-        _renderer = SDL_CreateRenderer(window, nullptr);
+        // Measurement switch: a file named "software-renderer" next to the
+        // binary forces SDL's software path, so the two can be compared on the
+        // same map. A file and not an environment variable, because the AROS
+        // Shell's setenv does not reach getenv().
+        const bool forceSoftware = [] {
+            std::error_code ec;
+            auto marker = Environment::getPathNoWarning(Environment::PathId::openlocoYML).parent_path() / "software-renderer";
+            return fs::exists(marker, ec);
+        }();
+
+        _renderer = SDL_CreateRenderer(window, forceSoftware ? "software" : nullptr);
         if (_renderer == nullptr)
         {
             // Try to fallback to software renderer.
@@ -90,6 +102,17 @@ namespace OpenLoco::Gfx
         }
 
         _window = window;
+
+        // Logged once, not per frame: which renderer SDL actually gave us and
+        // at what size. "The renderer is X" was guesswork until this existed.
+        {
+            const char* name = SDL_GetRendererName(_renderer);
+            int w = 0, h = 0;
+            SDL_GetCurrentRenderOutputSize(_renderer, &w, &h);
+            Logging::info("Renderer: {} ({}x{}){}", name != nullptr ? name : "?", w, h,
+                forceSoftware ? " [forced by the software-renderer file]" : " [SDL's default choice]");
+        }
+
         createPalette();
     }
 
