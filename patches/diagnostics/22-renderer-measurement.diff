         // Display buffers.
+        // Count presentations, not loop iterations: an iteration of the message
+        // loop may draw nothing, and the loop also spans startup, the title
+        // screen and the modal dialogs, each of which has its own pace. Timing
+        // here counts frames that actually reached the screen.
+        //
+        // Summarised every 30 s of presenting, so a run yields a series and the
+        // stretch belonging to gameplay can be read separately from the title
+        // screen. Nothing is printed per frame.
+        {
+            using clock = std::chrono::steady_clock;
+            static std::vector<uint32_t> gaps;
+            static clock::time_point windowStart{};
+            static clock::time_point last{};
+
+            const auto now = clock::now();
+            if (last.time_since_epoch().count() != 0)
+            {
+                gaps.push_back(static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::microseconds>(now - last).count()));
+            }
+            else
+            {
+                windowStart = now;
+                gaps.reserve(4096);
+            }
+            last = now;
+
+            if (std::chrono::duration_cast<std::chrono::seconds>(now - windowStart).count() >= 30 && gaps.size() > 10)
+            {
+                auto v = gaps;
+                std::sort(v.begin(), v.end());
+                const auto pct = [&v](double q) { return v[static_cast<size_t>((v.size() - 1) * q)]; };
