# renderer-measurement
#
# Diagnostic, for the renderer comparison: logs once which renderer SDL actually created and at what output size - that was guesswork before - and times each iteration of the message loop into a fixed in-memory array, printing one [FRAMES] summary (n, mean, median, p90, min, max, mean fps) after the loop ends, so the measurement does not measure its own printing. The first 20 frames are dropped as scene-transition cost. A file named 'software-renderer' next to the binary forces SDL's software path for the comparison; a file and not an environment variable because the AROS Shell's setenv does not reach getenv(). NOT for upstream and not for a release build.
#
# Against OpenLoco af445f8dc6632c6341fc7b26c3246685406e6815, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-20.

diff --git a/src/App/src/Main.cpp b/src/App/src/Main.cpp
index 618774f..b1ea9a0 100644
--- a/src/App/src/Main.cpp
+++ b/src/App/src/Main.cpp
@@ -1,3 +1,8 @@
+#include <vector>
+#include <cstdio>
+#include <chrono>
+#include <array>
+#include <algorithm>
 #include <OpenLoco/Audio/Audio.h>
 #include <OpenLoco/CommandLine.h>
 #include <OpenLoco/Config.h>
@@ -251,9 +256,45 @@ namespace OpenLoco
 
         initialise();
 
+        // Frame times are collected in memory and summarised once at the end:
+        // printing per frame would measure the printing. The array is fixed so
+        // nothing allocates inside the loop.
+        static std::array<uint32_t, 20000> frameUs{};
+        size_t frames = 0;
+
+        auto last = std::chrono::steady_clock::now();
         while (Input::processMessages())
         {
             update();
+
+            const auto now = std::chrono::steady_clock::now();
+            const auto us = std::chrono::duration_cast<std::chrono::microseconds>(now - last).count();
+            last = now;
+            if (frames < frameUs.size())
+            {
+                frameUs[frames] = static_cast<uint32_t>(us);
+            }
+            frames++;
+        }
+
+        const size_t kept = std::min(frames, frameUs.size());
+        if (kept > 20)
+        {
+            // Drop the first 20: they include the scene transition and the
+            // first draws, which are not what a steady frame costs.
+            std::vector<uint32_t> v(frameUs.begin() + 20, frameUs.begin() + kept);
+            std::sort(v.begin(), v.end());
+            const auto pct = [&v](double p) { return v[static_cast<size_t>((v.size() - 1) * p)]; };
+            double sum = 0.0;
+            for (auto x : v)
+            {
+                sum += x;
+            }
+            const double mean = sum / v.size();
+            std::printf("[FRAMES] n=%zu mean=%.1fms median=%.1fms p90=%.1fms min=%.1fms max=%.1fms -> %.1f fps mean\n",
+                v.size(), mean / 1000.0, pct(0.5) / 1000.0, pct(0.9) / 1000.0,
+                v.front() / 1000.0, v.back() / 1000.0, 1000000.0 / mean);
+            std::fflush(stdout);
         }
     }
 
