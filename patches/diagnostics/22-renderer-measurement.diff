+                    secs, v.size() + 1, (v.size() + 1) / secs,
+                    pct(0.5) / 1000.0, pct(0.9) / 1000.0, v.back() / 1000.0);
+                std::fflush(stdout);
+                gaps.clear();
+                windowStart = now;
+            }
+        }
+
