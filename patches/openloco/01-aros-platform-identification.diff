# aros-platform-identification
#
# Version.hpp does not know __AROS__ and stops at an #error, and Platform.Posix
# cannot obtain the program's own path without /proc: on AROS that is
# GetProgramDir() + NameFromLock(). Worth sending upstream.
#
# Against OpenLoco af445f8dc6632c6341fc7b26c3246685406e6815, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-13.

diff --git a/src/Platform/src/Platform.Posix.cpp b/src/Platform/src/Platform.Posix.cpp
index 2aa08d7..e8d5067 100644
--- a/src/Platform/src/Platform.Posix.cpp
+++ b/src/Platform/src/Platform.Posix.cpp
@@ -15,6 +15,16 @@
 #include <unistd.h>
 #endif
 
+#ifdef __AROS__
+// GetProgramDir()/NameFromLock() for the executable path; AROS has no /proc.
+// <graphics/gfx.h> first: <proto/dos.h> reaches <graphics/clip.h> through
+// <intuition/intuition.h>, and clip.h uses struct Rectangle without declaring
+// it. Without this the failure is reported inside an SDK header and looks like
+// a broken SDK rather than an include order problem.
+#include <graphics/gfx.h>
+#include <proto/dos.h>
+#endif
+
 #if defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__)
 #include <sys/sysctl.h>
 #include <sys/types.h>
@@ -127,6 +137,27 @@ namespace OpenLoco::Platform
         // There is no way to get the path name of a running executable.
         // If you are not using the port or package, you may have to change this line!
         strlcpy(exePath, "/usr/local/bin/", sizeof(exePath));
+#elif defined(__AROS__)
+        // AROS has no /proc. The directory the program was started from is the
+        // PROGDIR: assign, and NameFromLock() turns its lock into a real path.
+        // Callers only ever take parent_path() of this, so appending the
+        // program name would be wasted work; we return the directory itself,
+        // with a trailing separator so parent_path() still yields it.
+        if (!NameFromLock(GetProgramDir(), exePath, sizeof(exePath)))
+        {
+            fprintf(stderr, "failed to resolve PROGDIR:");
+            return {};
+        }
+        {
+            const size_t len = strlen(exePath);
+            // AmigaDOS paths end in ':' for a volume/assign root, which already
+            // separates; otherwise we need an explicit '/'.
+            if (len > 0 && exePath[len - 1] != ':' && len + 1 < sizeof(exePath))
+            {
+                exePath[len] = '/';
+                exePath[len + 1] = '\0';
+            }
+        }
 #else
 #error "Platform does not support full path exe retrieval"
 #endif // __linux__
diff --git a/src/Version/include/OpenLoco/Version.hpp b/src/Version/include/OpenLoco/Version.hpp
index ffe092d..dafb628 100644
--- a/src/Version/include/OpenLoco/Version.hpp
+++ b/src/Version/include/OpenLoco/Version.hpp
@@ -42,6 +42,8 @@
     #define OPENLOCO_PLATFORM "NetBSD"
 #elif defined(__OpenBSD__)
     #define OPENLOCO_PLATFORM "OpenBSD"
+#elif defined(__AROS__)
+    #define OPENLOCO_PLATFORM "AROS"
 #else
     #error "OPENLOCO_PLATFORM is undefined. Please add identification."
 #endif
