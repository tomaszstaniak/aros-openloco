# aros-user-dir-resolve-progdir
#
# The previous version returned a literal "PROGDIR:OpenLoco". std::filesystem
# treats ':' as an ordinary character, so create_directories() on
# "PROGDIR:OpenLoco/logs" threw filesystem_error and the game aborted during
# startup. Resolve PROGDIR: to a real path through GetProgramDir() +
# NameFromLock() instead.
#
# Against OpenLoco af445f8dc6632c6341fc7b26c3246685406e6815, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-13.

diff --git a/src/Platform/src/Platform.Posix.cpp b/src/Platform/src/Platform.Posix.cpp
index cc42d67..1226585 100644
--- a/src/Platform/src/Platform.Posix.cpp
+++ b/src/Platform/src/Platform.Posix.cpp
@@ -96,6 +96,8 @@ namespace OpenLoco::Platform
         throw Exception::RuntimeError("OpenLoco data path could not be found!");
     }
 
+    fs::path getCurrentExecutablePath();
+
     fs::path getUserDirectory()
     {
 #ifdef __AROS__
@@ -103,9 +105,12 @@ namespace OpenLoco::Platform
         // getpwuid() yields "/home", so the settings ended up in a
         // "/home/.config/OpenLoco" that does not exist and cannot be created.
         // The Amiga convention is for a program to keep its own files next to
-        // itself, which PROGDIR: names; that directory is writable whenever the
-        // program was started from a writable volume.
-        return fs::path("PROGDIR:OpenLoco");
+        // itself. Note the assign name cannot be handed to std::filesystem as
+        // text: "PROGDIR:OpenLoco/logs" makes create_directories() throw,
+        // because ':' is a volume separator to AmigaDOS but an ordinary
+        // character to a POSIX path. Resolve it to a real path first -
+        // getCurrentExecutablePath() already does exactly that.
+        return getCurrentExecutablePath() / fs::path("OpenLoco");
 #else
         auto path = fs::path(getEnvironmentVariable("XDG_CONFIG_HOME"));
         if (path.empty())
