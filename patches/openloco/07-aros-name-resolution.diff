@@ -47,6 +47,11 @@
     #include <sys/ioctl.h>
     #include <sys/socket.h>
     #include <unistd.h>
+    #ifdef __AROS__
+        // AROS has the BSD 4.3 socket API but not RFC 3493 name resolution;
+        // see the header for exactly what is and is not provided.
+        #include "ArosNetCompat.hpp"
+    #endif
     using SOCKET = int32_t;
     #define SOCKET_ERROR -1
     #define INVALID_SOCKET -1
@@ -304,7 +309,12 @@ namespace OpenLoco::Network
         static bool setOption(SOCKET socket, int32_t a, int32_t b, bool value)
         {
             int32_t ivalue = value ? 1 : 0;
+#ifdef __AROS__
+            // AROS's setsockopt() takes a non-const value pointer.
+            return setsockopt(socket, a, b, reinterpret_cast<char*>(&ivalue), sizeof(ivalue)) == 0;
+#else
             return setsockopt(socket, a, b, reinterpret_cast<const char*>(&ivalue), sizeof(ivalue)) == 0;
+#endif
         }
 
         static int protocolToFamily(Protocol protocol)
