# aros-version-identifier
#
# Let the build supply the version identifiers instead of reading git. The port
# builds from a work tree that bootstrap.sh regenerates, so the commit hash
# CMake finds there is a throwaway: it changes on every bootstrap and names
# neither OpenLoco upstream nor the port. It looks exactly like a version
# number, and it has already misled the reading of measurement evidence once.
#
# With this, build-openloco.sh passes the upstream commit, the port revision
# and the patch set, and the title bar reads e.g.
#   OpenLoco, 7f8c90cf+aros (383e679 on openloco-next+19)
# Upstream behaviour is unchanged: with none of the three defined, git is read
# exactly as before. Backlog item 17.
#
# Against OpenLoco 7f8c90cfb44e12d8b47e73e69edc5cb0d5ee7b1e, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-20.

diff --git a/cmake/OpenLocoVersion.cmake b/cmake/OpenLocoVersion.cmake
index 357ce82..fbf3395 100644
--- a/cmake/OpenLocoVersion.cmake
+++ b/cmake/OpenLocoVersion.cmake
@@ -1,3 +1,13 @@
+# The build may supply the identifiers itself, in which case git is not asked.
+# The AROS port builds from a work tree that bootstrap.sh regenerates, so the
+# commit hash git would report here is a throwaway that changes on every
+# bootstrap and names neither upstream nor the port. build-openloco.sh passes
+# the upstream commit and the port revision instead.
+if (DEFINED OPENLOCO_VERSION_TAG AND DEFINED OPENLOCO_BRANCH AND DEFINED OPENLOCO_COMMIT_SHA1_SHORT)
+    message(STATUS "Version supplied by the build: ${OPENLOCO_VERSION_TAG} | Branch: ${OPENLOCO_BRANCH} | Commit: ${OPENLOCO_COMMIT_SHA1_SHORT}")
+    return()
+endif()
+
 include(FindGit)
 
 find_package(Git)
