new file mode 100644
index 0000000..017eca0
--- /dev/null
+++ b/src/Core/include/OpenLoco/Core/SafeOverwrite.hpp
@@ -0,0 +1,46 @@
+/// @file
+/// Replacing a file's contents, on systems where the obvious way is broken.
+///
+/// On AROS, opening an existing file with O_TRUNC - which is what fopen("wb")
+/// and std::ofstream's default do - **silently loses the data**: the open
+/// succeeds, the writes report the full byte count, close() returns 0, and the
+/// file afterwards reads back as 0 bytes. Measured on AROS One 1.3 / ABIv11 on
+/// a FAT32 volume, 4 attempts out of 4, and the loss survives a reboot, so it
+/// is destruction rather than a caching artefact. Creating a file that does not
+/// exist yet works, and so does deleting one; both were verified byte for byte
+/// after a guest restart.
+///
+/// So: remove the target first, then let the caller create it fresh. Two
+/// operations that are known to work, instead of one that is known not to.
+///
+/// **What this does not give**: atomicity. If the write then fails halfway, the
+/// previous contents are gone. That is no worse than the current behaviour -
+/// today the file is destroyed even when the write "succeeds" - but it is not
+/// the end state. The safe sequence is to write a temporary file, verify it,
+/// and rename it over the target; `rename()` onto both a free and an occupied
+/// name was measured to work and to persist on this system, so that refinement
+/// is possible and is tracked as a follow-up.
+///
+/// Elsewhere this is a no-op, so behaviour on other platforms is unchanged.
+
+#pragma once
+
+#include "FileSystem.hpp"
+
+namespace OpenLoco
+{
+#ifdef __AROS__
+    inline void prepareForOverwrite(const fs::path& path)
+    {
+        std::error_code ec;
+        if (fs::exists(path, ec))
+        {
+            fs::remove(path, ec);
+        }
+    }
+#else
+    inline void prepareForOverwrite(const fs::path&)
+    {
+    }
+#endif
+}
