# aros-socket-macro-wrappers
#
# AROS definiuje bind/socket/listen/sendto/recvfrom/setsockopt jako makra funkcyjne; bind koliduje ze std::bind z <functional>, wciaganego pozniej przez fmt/std.h, a blad jest raportowany wewnatrz libstdc++. Przechwytujemy makra w funkcje inline, potem je usuwamy; wywolania ida przez aros* pod #ifdef. Zadnych makr o tych nazwach - obiektowe makro bind psuje std::bind tak samo.
#
# Against OpenLoco af445f8dc6632c6341fc7b26c3246685406e6815, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-13.

diff --git a/src/OpenLoco/src/Network/ArosNetCompat.hpp b/src/OpenLoco/src/Network/ArosNetCompat.hpp
index 212e93d..3fa6631 100644
--- a/src/OpenLoco/src/Network/ArosNetCompat.hpp
+++ b/src/OpenLoco/src/Network/ArosNetCompat.hpp
@@ -210,6 +210,60 @@ namespace OpenLoco::Network::ArosCompat
     }
 }
 
+// ---------------------------------------------------------------------------
+// bsdsocket's function-like macros vs C++ headers
+//
+// <defines/bsdsocket.h> defines socket(), bind(), listen(), sendto(),
+// recvfrom(), setsockopt() and three dozen more as function-like macros that
+// pass SocketBase implicitly. That is fine for C, but `bind` collides with
+// std::bind the moment <functional> is included — which happens later here
+// through fmt/std.h — and the failure is reported inside libstdc++, where it
+// looks like a broken standard library.
+//
+// So: capture each macro we use in an inline function while it is still
+// defined, then undefine it. The call sites below switch to these names.
+namespace OpenLoco::Network::ArosCompat
+{
+    inline int arosSocket(int domain, int type, int protocol)
+    {
+        return socket(domain, type, protocol);
+    }
+    inline int arosBind(int s, struct sockaddr* addr, socklen_t len)
+    {
+        return bind(s, addr, len);
+    }
+    inline int arosListen(int s, int backlog)
+    {
+        return listen(s, backlog);
+    }
+    inline int arosSetSockOpt(int s, int level, int name, char* val, socklen_t len)
+    {
+        return setsockopt(s, level, name, val, len);
+    }
+    inline int arosSendTo(int s, const void* buf, size_t len, int flags,
+                          const struct sockaddr* to, socklen_t tolen)
+    {
+        return sendto(s, const_cast<void*>(buf), len, flags,
+                      const_cast<struct sockaddr*>(to), tolen);
+    }
+    inline int arosRecvFrom(int s, void* buf, size_t len, int flags,
+                            struct sockaddr* from, socklen_t* fromlen)
+    {
+        return recvfrom(s, buf, len, flags, from, fromlen);
+    }
+}
+
+#undef socket
+#undef bind
+#undef listen
+#undef setsockopt
+#undef sendto
+#undef recvfrom
+
+// Deliberately NOT re-#defined under the original names: an object-like macro
+// called `bind` breaks std::bind just as thoroughly as the function-like one
+// did. The call sites use the aros* names directly, under #ifdef __AROS__.
+
 // The call sites stay as they are; these names simply resolve to the shim.
 #define inet_ntop    ::OpenLoco::Network::ArosCompat::inetNtop
 #define getaddrinfo  ::OpenLoco::Network::ArosCompat::getAddrInfo
