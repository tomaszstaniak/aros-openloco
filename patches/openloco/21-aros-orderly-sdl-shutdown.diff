# aros-orderly-sdl-shutdown
#
# Completes the shutdown that upstream - even with #4018, patch 20 - leaves
# unfinished: the game window is never destroyed and SDL_Quit() is commented
# out. Adds Ui::disposeWindow() and calls it after the drawing engine is
# disposed (the renderer belongs to the window), then calls SDL_Quit() where
# upstream has it commented out.
#
# The order was checked against ownership before writing: the only static SDL
# holders are raw pointers (_window, _cursors) and the drawing engine, which
# patch 20 disposes explicitly first - so no static destructor running after
# exit() touches SDL after SDL_Quit().
#
# Verified on AROS One / ABIv11 (2026-09-19, with diagnostic markers in place):
# the window disappears on exit, the Shell prompt returns, one unfreed signal
# is reported instead of five, and a second start works. Motivated by the stale
# Intuition window; NOT claimed as the cause of backlog item 21.
#
# Against OpenLoco af445f8dc6632c6341fc7b26c3246685406e6815, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-20.

diff --git a/src/OpenLoco/include/OpenLoco/Ui.h b/src/OpenLoco/include/OpenLoco/Ui.h
index be35216..7c9a6eb 100644
--- a/src/OpenLoco/include/OpenLoco/Ui.h
+++ b/src/OpenLoco/include/OpenLoco/Ui.h
@@ -99,6 +99,7 @@ namespace OpenLoco::Ui
     void initialise();
     void initialiseCursors();
     void disposeCursors();
+    void disposeWindow();
     void setCursor(CursorId id);
     CursorId getCursor();
     Point getCursorPosScaled();
diff --git a/src/OpenLoco/src/OpenLoco.cpp b/src/OpenLoco/src/OpenLoco.cpp
index 0b66c55..63682bf 100644
--- a/src/OpenLoco/src/OpenLoco.cpp
+++ b/src/OpenLoco/src/OpenLoco.cpp
@@ -1,3 +1,4 @@
+#include <SDL3/SDL.h>
 #include "Scenario/Scenario.h"
 #include <algorithm>
 #include <cassert>
@@ -99,6 +100,11 @@ namespace OpenLoco
 
         OpenLoco::Gfx::disposeDrawingEngine();
 
+        // The order follows ownership: the renderer (gone with the drawing
+        // engine above) belongs to the window, and every SDL object has to be
+        // released before SDL_Quit() below.
+        Ui::disposeWindow();
+
         auto tempFilePath = Environment::getPathNoWarning(Environment::PathId::_1tmp);
         if (fs::exists(tempFilePath))
         {
@@ -111,7 +117,12 @@ namespace OpenLoco
         // Logging should be the last before terminating.
         Logging::shutdown();
 
-        // SDL_Quit();
+        // Upstream has this commented out. Nothing SDL-owned is left by now:
+        // cursors, drawing engine and window are all released above, and no
+        // static destructor that runs after exit() touches SDL - the only
+        // static SDL holders are raw pointers and the drawing engine, which is
+        // disposed explicitly above.
+        SDL_Quit();
         exit(0);
     }
 
diff --git a/src/OpenLoco/src/Ui.cpp b/src/OpenLoco/src/Ui.cpp
index 51d2c4f..54e2ba3 100644
--- a/src/OpenLoco/src/Ui.cpp
+++ b/src/OpenLoco/src/Ui.cpp
@@ -385,6 +385,19 @@ namespace OpenLoco::Ui
         loadCursor(CursorId::placeStation, Cursor::placeStation);
     }
 
+    // Destroys the game window. Must run after the drawing engine has been
+    // disposed - its renderer belongs to this window - and before SDL_Quit().
+    // Upstream never destroys the window at all; on AROS that left the
+    // Intuition window on screen after the program had exited.
+    void disposeWindow()
+    {
+        if (_window != nullptr)
+        {
+            SDL_DestroyWindow(_window);
+            _window = nullptr;
+        }
+    }
+
