# gcc10-span-from-static-vector
#
# GCC 10's std::span does not accept sfl::static_vector through its range
# constructor: its contiguous_range detection predates the final wording. The
# pointer+size constructor means the same thing and always works.
#
# Against OpenLoco af445f8dc6632c6341fc7b26c3246685406e6815, applied with -p1 by scripts/bootstrap.sh.
# Saved 2026-09-13.

diff --git a/src/OpenLoco/src/Map/MapSelection.cpp b/src/OpenLoco/src/Map/MapSelection.cpp
index b8539c6..ef79b84 100644
--- a/src/OpenLoco/src/Map/MapSelection.cpp
+++ b/src/OpenLoco/src/Map/MapSelection.cpp
@@ -163,7 +163,10 @@ namespace OpenLoco::World
 
     std::span<const Pos2> getMapSelectionFreeFormTiles()
     {
-        return _mapSelectedFreeFormTiles;
+        // GCC 10's std::span does not accept sfl::static_vector through its range
+        // constructor: its contiguous_range detection predates the final wording.
+        // The pointer+size constructor is unconditional and means the same thing.
+        return { _mapSelectedFreeFormTiles.data(), _mapSelectedFreeFormTiles.size() };
     }
 
     // 0x0046112C
