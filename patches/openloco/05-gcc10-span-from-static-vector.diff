-            paintStationCargo(session, elStation, cargoFlags[1], cargoTypeFlags, cargoOffsets, elStation.baseHeight(), bbOffset, platformImages.back.bbSize);
+            paintStationCargo(session, elStation, cargoFlags[0], cargoTypeFlags, cargoOffsetsSpan, elStation.baseHeight(), bbOffset, platformImages.back.bbSize);
